#!/usr/bin/env bash

set -Eeuo pipefail

readonly SCRIPT_NAME="$(basename "$0")"
readonly VOLUME_TEMPLATE_ANNOTATION="harvesterhci.io/volumeClaimTemplates"
readonly IMAGE_ID_ANNOTATION="harvesterhci.io/imageId"
readonly STRESS_RUN_LABEL="csi.harvesterhci.io/stress-run"
readonly STRESS_ITERATION_LABEL="csi.harvesterhci.io/stress-iteration"
readonly CLOUD_INIT_PASSWORD="password1234"
readonly BOOT_TEMPLATE_INDEX=0
readonly DATA_VOLUME_PREFIX="data-disk"
readonly DATA_DISK_SERIAL_PREFIX="csi-data"

NAMESPACE="default"
KUBECONFIG_PATH="${KUBECONFIG:-}"
KUBECONFIG_FROM_OPTION=false
IMAGE_URL=""
IMAGE_STORAGE_CLASS=""
DATA_STORAGE_CLASS=""
CPU=""
MEMORY=""
BOOT_SIZE_GIB=50
DATA_VOLUME_COUNT=1
DATA_VOLUME_SIZE_GIB=100
BOOT_VOLUME_MODE="Block"
DATA_VOLUME_MODE="Filesystem"
BOOT_ACCESS_MODE="ReadWriteOnce"
DATA_ACCESS_MODE="ReadWriteOnce"
NETWORK_NAME="default/mgmt-vlan"
GUEST_INTERFACE_NAME="enp1s0"
NODE_SELECTOR="network.harvesterhci.io/mgmt=true"
NODE_SELECTOR_KEY=""
NODE_SELECTOR_VALUE=""
ITERATIONS=""
PARALLEL=1
SSH_USER="ubuntu"
SSH_IDENTITY_FILE=""
SSH_PUBLIC_KEY=""
CLOUD_INIT_USER_DATA=""
CLOUD_INIT_NETWORK_DATA=""
GUEST_DEVICE="/dev/vdb"
GUEST_MOUNT_PATH="/mnt/csi-stress"
ROOT_PAYLOAD_DIRECTORY="/var/lib/csi-stress"
DATA_SIZE_GIB=10
ROOT_DATA_SIZE_GIB=1
TIMEOUT_SECONDS=3600
SSH_TIMEOUT_SECONDS=900
SSH_CONNECT_TIMEOUT_SECONDS=30
SSH_VM_RETRIES=0
CDI_CLONE_RETRIES=1
CDI_CERT_SYNC_TIMEOUT_SECONDS=120
POLL_INTERVAL_SECONDS=5
SNAPSHOT_ERROR_GRACE_SECONDS=60
VM_BACKUP_TYPES="snapshot"
VM_BACKUP_TYPE_LIST=()
KEEP_RESOURCES=false
KEEP_FAILED_RESOURCES=false
CLEANUP_MODE=false
CLEANUP_RUN_ID=""

RUN_ID=""
RUN_TOKEN=""
IMAGE_NAME=""
CURRENT_VM=""
CURRENT_BACKUP=""
CURRENT_BACKUP_TYPE=""
CURRENT_RESTORE=""
CURRENT_RESTORED_VM=""
CURRENT_ITERATION=""
CURRENT_BOOT_PVC=""
STRESS_TMP_DIR=""
LOG_PREFIX=""
ACTIVE_PIDS=()
PARENT_SIGNALLED=false
WORKER_SIGNALLED=false
CURRENT_FAILURE_CATEGORY=""
SSH_FAILURE_STAGE=""
LAST_SSH_ERROR=""
CURRENT_DIAGNOSTICS_COLLECTED=false

usage() {
	cat <<EOF
Usage:
  ${SCRIPT_NAME} \\
    --image-url URL \\
    --image-storage-class NAME \\
    --data-storage-class NAME \\
    --cpu COUNT \\
    --memory QUANTITY \\
    --iterations COUNT [options]

Cleanup:
  ${SCRIPT_NAME} --cleanup [--namespace NAME] [--timeout SECONDS]
  ${SCRIPT_NAME} --cleanup-run RUN_ID [--namespace NAME] [--timeout SECONDS]

Required arguments:
  --image-url URL          Source URL for the Harvester VirtualMachineImage.
  --image-storage-class NAME
                           StorageClass for the VM image and boot PVCs.
  --data-storage-class NAME
                           StorageClass for the data PVC.
  --cpu COUNT              Positive integer vCPU count for each test VM.
  --memory QUANTITY        Kubernetes memory quantity, for example 4Gi.
  --iterations COUNT       Backup/restore iterations run by each worker.

Options:
  --namespace NAME         Namespace for all namespaced resources (default: default).
  --kubeconfig PATH        Kubeconfig file to use. Defaults to the KUBECONFIG
                           environment variable, then Kubernetes' standard lookup.
  --boot-size-gib COUNT    Boot PVC capacity in GiB (default: 50).
  --data-volume-count COUNT
                           Number of identical data PVCs per VM (default: 1).
  --data-volume-size-gib COUNT
                           Capacity of each data PVC in GiB (default: 100).
  --boot-volume-mode MODE  Boot PVC mode: Block or Filesystem (default: Block).
  --data-volume-mode MODE  Data PVC mode: Block or Filesystem (default: Filesystem).
  --boot-access-mode MODE  Boot PVC access mode (default: ReadWriteOnce).
  --data-access-mode MODE  Data PVC access mode (default: ReadWriteOnce).
  --network-name NAME      Multus NetworkAttachmentDefinition as [namespace/]name
                           (default: default/mgmt-vlan).
  --guest-interface-name NAME
                           Linux interface configured by cloud-init (default: enp1s0).
  --node-selector KEY=VALUE
                           Required VM node selector. Pass an empty value to disable
                           (default: network.harvesterhci.io/mgmt=true).
  --parallel COUNT         Number of concurrent VM workflow workers (default: 1).
  --data-size-gib COUNT    Random payload size written to each data disk in GiB
                           (default: 10).
  --root-data-size-gib COUNT
                           Random root-disk payload size in GiB (default: 1).
  --timeout SECONDS        Timeout for each asynchronous operation (default: 3600).
  --ssh-timeout SECONDS    Total timeout for guest SSH readiness and transient
                           guest-operation SSH retries (default: 900).
  --ssh-connect-timeout SECONDS
                           Timeout for each SSH connection and banner exchange
                           (default: 30).
  --ssh-vm-retries COUNT   Additional fresh iteration attempts after VM/PVC
                           provisioning or guest SSH readiness times out
                           (default: 0).
  --cdi-clone-retries COUNT
                           Fresh iteration attempts after the CDI clone source
                           pod reports the known HTTP 401 error (default: 1).
  --poll-interval SECONDS  Status polling interval (default: 5).
  --snapshot-error-grace SECONDS
                           Continue waiting this long after a VM backup reports
                           an error so controller retries can recover (default: 60;
                           use 0 for fail-fast behavior).
  --vm-backup-types TYPES  VirtualMachineBackup type: snapshot, backup, restic, or
                           kopia (default: snapshot). Supply two comma-separated,
                           distinct types to alternate them between iterations,
                           for example restic,kopia.
  --ssh-user USER          Cloud image's default SSH user (default: ubuntu).
  --ssh-identity-file PATH Existing unencrypted private key to inject and use.
                           By default, the script generates an ephemeral key.
  --guest-device PATH      Guest data disk device when --data-volume-count is 1
                           (default: /dev/vdb). Multi-disk runs resolve disks by
                           their generated virtio serials.
  --guest-mount-path PATH  Guest mount point for one data disk, or base directory
                           for multiple disks (default: /mnt/csi-stress).
  --keep-resources         Do not remove resources created by the script.
  --keep-failed-resources  Retain only the failed iteration and shared image for
                           diagnostics; successful iterations are still removed.
	--cleanup                List and delete resources from all stress and benchmark runs.
  --cleanup-run RUN_ID     List and delete resources from one stress run.
  -h, --help               Show this help.

The script creates a minimal KubeVirt VM manifest and VMImage for each run. For
example, --iterations 10 --parallel 3 starts three concurrent workers. Each
worker runs ten VM backup, restore, and integrity-check cycles (30 total).
Parallel execution requires Bash 5.1 or newer.

Each data disk receives the same capacity, volume mode, access mode, and payload
size. For example, --data-volume-count 15 creates 16 PVCs per VM: one boot PVC
and 15 data PVCs.

Cloud-init configures DHCP on --guest-interface-name and installs
qemu-guest-agent. The script uses virtctl ssh and requires passwordless sudo, as
provided by the default ubuntu cloud-image user.
EOF
}

log() {
	printf '[%s] %s%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$LOG_PREFIX" "$*"
}

fail() {
	log "ERROR: $*" >&2
	exit 1
}

require_positive_integer() {
	local name="$1"
	local value="$2"
	[[ "$value" =~ ^[1-9][0-9]*$ ]] || fail "${name} must be a positive integer, got ${value@Q}"
}

require_non_negative_integer() {
	local name="$1"
	local value="$2"
	[[ "$value" =~ ^[0-9]+$ ]] || fail "${name} must be a non-negative integer, got ${value@Q}"
}

require_enum() {
	local name="$1"
	local value="$2"
	shift 2
	local candidate=""

	for candidate in "$@"; do
		[[ "$value" == "$candidate" ]] && return 0
	done
	fail "invalid ${name} value: ${value@Q}"
}

resource_name() {
	local value="$1"
	value="$(tr '[:upper:]_' '[:lower:]-' <<<"$value" | sed -E 's/[^a-z0-9.-]+/-/g; s/^[^a-z0-9]+//; s/[^a-z0-9]+$//')"
	value="${value:0:63}"
	value="$(sed -E 's/[^a-z0-9]+$//' <<<"$value")"
	[[ -n "$value" ]] || return 1
	printf '%s\n' "$value"
}

data_volume_name() {
	local index="$1"

	printf '%s-%s\n' "$DATA_VOLUME_PREFIX" "$index"
}

data_pvc_name() {
	local vm_name="$1"
	local index="$2"

	printf '%s-pvc-%s\n' "$vm_name" "$index"
}

data_disk_serial() {
	local index="$1"

	printf '%s-%s\n' "$DATA_DISK_SERIAL_PREFIX" "$index"
}

guest_data_device() {
	local index="$1"

	if ((DATA_VOLUME_COUNT == 1)); then
		printf '%s\n' "$GUEST_DEVICE"
		return
	fi
	printf '/dev/disk/by-id/virtio-%s\n' "$(data_disk_serial "$index")"
}

guest_data_mount() {
	local index="$1"

	if ((DATA_VOLUME_COUNT == 1)); then
		printf '%s\n' "$GUEST_MOUNT_PATH"
		return
	fi
	printf '%s/disk-%s\n' "${GUEST_MOUNT_PATH%/}" "$index"
}

expected_volume_names() {
	jq -nc \
		--arg dataPrefix "$DATA_VOLUME_PREFIX" \
		--argjson dataCount "$DATA_VOLUME_COUNT" '
      ["boot-disk"] + [range(1; $dataCount + 1) | ($dataPrefix + "-" + tostring)]
    '
}

while (($# > 0)); do
	case "$1" in
	--image-url)
		IMAGE_URL="${2:-}"
		shift 2
		;;
	--image-storage-class)
		IMAGE_STORAGE_CLASS="${2:-}"
		shift 2
		;;
	--data-storage-class)
		DATA_STORAGE_CLASS="${2:-}"
		shift 2
		;;
	--cpu)
		CPU="${2:-}"
		shift 2
		;;
	--memory)
		MEMORY="${2:-}"
		shift 2
		;;
	--boot-size-gib)
		BOOT_SIZE_GIB="${2:-}"
		shift 2
		;;
	--data-volume-count)
		DATA_VOLUME_COUNT="${2:-}"
		shift 2
		;;
	--data-volume-size-gib)
		DATA_VOLUME_SIZE_GIB="${2:-}"
		shift 2
		;;
	--boot-volume-mode)
		BOOT_VOLUME_MODE="${2:-}"
		shift 2
		;;
	--data-volume-mode)
		DATA_VOLUME_MODE="${2:-}"
		shift 2
		;;
	--boot-access-mode)
		BOOT_ACCESS_MODE="${2:-}"
		shift 2
		;;
	--data-access-mode)
		DATA_ACCESS_MODE="${2:-}"
		shift 2
		;;
	--network-name)
		NETWORK_NAME="${2:-}"
		shift 2
		;;
	--guest-interface-name)
		GUEST_INTERFACE_NAME="${2:-}"
		shift 2
		;;
	--node-selector)
		NODE_SELECTOR="${2:-}"
		shift 2
		;;
	--iterations)
		ITERATIONS="${2:-}"
		shift 2
		;;
	--parallel)
		PARALLEL="${2:-}"
		shift 2
		;;
	--ssh-user)
		SSH_USER="${2:-}"
		shift 2
		;;
	--ssh-identity-file)
		SSH_IDENTITY_FILE="${2:-}"
		shift 2
		;;
	--namespace)
		NAMESPACE="${2:-}"
		shift 2
		;;
	--kubeconfig)
		(($# >= 2)) && [[ -n "$2" ]] || fail "--kubeconfig requires a path"
		KUBECONFIG_PATH="$2"
		KUBECONFIG_FROM_OPTION=true
		shift 2
		;;
	--data-size-gib)
		DATA_SIZE_GIB="${2:-}"
		shift 2
		;;
	--root-data-size-gib)
		ROOT_DATA_SIZE_GIB="${2:-}"
		shift 2
		;;
	--timeout)
		TIMEOUT_SECONDS="${2:-}"
		shift 2
		;;
	--ssh-timeout)
		SSH_TIMEOUT_SECONDS="${2:-}"
		shift 2
		;;
	--ssh-connect-timeout)
		SSH_CONNECT_TIMEOUT_SECONDS="${2:-}"
		shift 2
		;;
	--ssh-vm-retries)
		SSH_VM_RETRIES="${2:-}"
		shift 2
		;;
	--cdi-clone-retries)
		CDI_CLONE_RETRIES="${2:-}"
		shift 2
		;;
	--poll-interval)
		POLL_INTERVAL_SECONDS="${2:-}"
		shift 2
		;;
	--snapshot-error-grace)
		SNAPSHOT_ERROR_GRACE_SECONDS="${2:-}"
		shift 2
		;;
	--vm-backup-types)
		VM_BACKUP_TYPES="${2:-}"
		shift 2
		;;
	--guest-device)
		GUEST_DEVICE="${2:-}"
		shift 2
		;;
	--guest-mount-path)
		GUEST_MOUNT_PATH="${2:-}"
		shift 2
		;;
	--keep-resources)
		KEEP_RESOURCES=true
		shift
		;;
	--keep-failed-resources)
		KEEP_FAILED_RESOURCES=true
		shift
		;;
	--cleanup)
		CLEANUP_MODE=true
		shift
		;;
	--cleanup-run)
		CLEANUP_MODE=true
		CLEANUP_RUN_ID="${2:-}"
		shift 2
		;;
	-h | --help)
		usage
		exit 0
		;;
	*)
		usage >&2
		fail "unknown argument: $1"
		;;
	esac
done

if [[ "$KUBECONFIG_FROM_OPTION" == true ]]; then
	[[ -f "$KUBECONFIG_PATH" ]] || fail "kubeconfig file not found: ${KUBECONFIG_PATH@Q}"
fi
if [[ -n "$KUBECONFIG_PATH" ]]; then
	export KUBECONFIG="$KUBECONFIG_PATH"
fi

if [[ "$CLEANUP_MODE" == true ]]; then
	for required_command in kubectl jq; do
		command -v "$required_command" >/dev/null 2>&1 || fail "required command not found: ${required_command}"
	done
	[[ "$KEEP_RESOURCES" == false ]] || fail "--keep-resources cannot be used with cleanup mode"
	[[ "$KEEP_FAILED_RESOURCES" == false ]] || fail "--keep-failed-resources cannot be used with cleanup mode"
	if [[ -n "$CLEANUP_RUN_ID" ]]; then
		[[ "$CLEANUP_RUN_ID" =~ ^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$ ]] ||
			fail "invalid --cleanup-run value: ${CLEANUP_RUN_ID@Q}"
	fi
	require_positive_integer "--timeout" "$TIMEOUT_SECONDS"
else
	if ((BASH_VERSINFO[0] < 5 || (BASH_VERSINFO[0] == 5 && BASH_VERSINFO[1] < 1))); then
		fail "stress-test mode requires Bash 5.1 or newer"
	fi
	for required_command in kubectl jq virtctl base64 sha256sum ssh-keygen; do
		command -v "$required_command" >/dev/null 2>&1 || fail "required command not found: ${required_command}"
	done

	[[ -n "$IMAGE_URL" ]] || fail "--image-url is required"
	[[ -n "$IMAGE_STORAGE_CLASS" ]] || fail "--image-storage-class is required"
	[[ -n "$DATA_STORAGE_CLASS" ]] || fail "--data-storage-class is required"
	[[ -n "$CPU" ]] || fail "--cpu is required"
	[[ -n "$MEMORY" ]] || fail "--memory is required"
	[[ -n "$ITERATIONS" ]] || fail "--iterations is required"
	if [[ "$KEEP_RESOURCES" == true && "$KEEP_FAILED_RESOURCES" == true ]]; then
		fail "--keep-resources and --keep-failed-resources cannot be used together"
	fi
	if [[ -n "$SSH_IDENTITY_FILE" ]]; then
		[[ -f "$SSH_IDENTITY_FILE" ]] || fail "SSH identity file not found: ${SSH_IDENTITY_FILE}"
	fi
	[[ "$SSH_USER" =~ ^[a-z_][a-z0-9_-]*$ ]] || fail "invalid --ssh-user: ${SSH_USER@Q}"
	[[ "$GUEST_DEVICE" =~ ^/dev/[a-zA-Z0-9._/-]+$ ]] || fail "invalid --guest-device: ${GUEST_DEVICE@Q}"
	[[ "$GUEST_MOUNT_PATH" =~ ^/mnt/[a-zA-Z0-9._/-]+$ ]] ||
		fail "--guest-mount-path must be a path below /mnt, got ${GUEST_MOUNT_PATH@Q}"
	[[ "$GUEST_INTERFACE_NAME" =~ ^[a-zA-Z0-9_.-]+$ ]] ||
		fail "invalid --guest-interface-name: ${GUEST_INTERFACE_NAME@Q}"
	[[ "$NETWORK_NAME" =~ ^([a-z0-9]([-a-z0-9.]*[a-z0-9])?/)?[a-z0-9]([-a-z0-9.]*[a-z0-9])?$ ]] ||
		fail "invalid --network-name: ${NETWORK_NAME@Q}"
	require_enum "--boot-volume-mode" "$BOOT_VOLUME_MODE" Block Filesystem
	require_enum "--data-volume-mode" "$DATA_VOLUME_MODE" Block Filesystem
	require_enum "--boot-access-mode" "$BOOT_ACCESS_MODE" ReadWriteOnce ReadWriteMany ReadOnlyMany ReadWriteOncePod
	require_enum "--data-access-mode" "$DATA_ACCESS_MODE" ReadWriteOnce ReadWriteMany ReadOnlyMany ReadWriteOncePod
	if [[ -n "$NODE_SELECTOR" ]]; then
		[[ "$NODE_SELECTOR" == *=* ]] || fail "--node-selector must use KEY=VALUE syntax"
		NODE_SELECTOR_KEY="${NODE_SELECTOR%%=*}"
		NODE_SELECTOR_VALUE="${NODE_SELECTOR#*=}"
		[[ -n "$NODE_SELECTOR_KEY" && -n "$NODE_SELECTOR_VALUE" ]] ||
			fail "--node-selector requires a non-empty key and value"
	fi

	require_positive_integer "--cpu" "$CPU"
	require_positive_integer "--iterations" "$ITERATIONS"
	require_positive_integer "--parallel" "$PARALLEL"
	require_positive_integer "--boot-size-gib" "$BOOT_SIZE_GIB"
	require_positive_integer "--data-volume-count" "$DATA_VOLUME_COUNT"
	require_positive_integer "--data-volume-size-gib" "$DATA_VOLUME_SIZE_GIB"
	require_positive_integer "--data-size-gib" "$DATA_SIZE_GIB"
	require_positive_integer "--root-data-size-gib" "$ROOT_DATA_SIZE_GIB"
	require_positive_integer "--timeout" "$TIMEOUT_SECONDS"
	require_positive_integer "--ssh-timeout" "$SSH_TIMEOUT_SECONDS"
	require_positive_integer "--ssh-connect-timeout" "$SSH_CONNECT_TIMEOUT_SECONDS"
	require_non_negative_integer "--ssh-vm-retries" "$SSH_VM_RETRIES"
	require_non_negative_integer "--cdi-clone-retries" "$CDI_CLONE_RETRIES"
	require_positive_integer "--poll-interval" "$POLL_INTERVAL_SECONDS"
	require_non_negative_integer "--snapshot-error-grace" "$SNAPSHOT_ERROR_GRACE_SECONDS"
	[[ "$VM_BACKUP_TYPES" =~ ^(snapshot|backup|restic|kopia)(,(snapshot|backup|restic|kopia))?$ ]] ||
		fail "--vm-backup-types must contain one or two comma-separated values from: snapshot, backup, restic, kopia"
	IFS=',' read -r -a VM_BACKUP_TYPE_LIST <<<"$VM_BACKUP_TYPES"
	if ((${#VM_BACKUP_TYPE_LIST[@]} == 2)); then
		[[ "${VM_BACKUP_TYPE_LIST[0]}" != "${VM_BACKUP_TYPE_LIST[1]}" ]] ||
			fail "--vm-backup-types values must be distinct when two types are supplied"
	fi
	((ROOT_DATA_SIZE_GIB < BOOT_SIZE_GIB)) ||
		fail "--root-data-size-gib must be smaller than --boot-size-gib"
	((DATA_SIZE_GIB < DATA_VOLUME_SIZE_GIB)) ||
		fail "--data-size-gib must be smaller than --data-volume-size-gib"

	RUN_ID="$(resource_name "csi-stress-$(date -u +%Y%m%d%H%M%S)-${RANDOM}")"
	# Remote engines embed the backup and PVC names in helper Job names and labels.
	# Use a compact, run-unique token so those derived values stay below 63 bytes.
	read -r run_hash _ < <(printf '%s' "$RUN_ID" | sha256sum)
	RUN_TOKEN="s${run_hash:0:8}"
	IMAGE_NAME="$(resource_name "${RUN_ID}-image")"
	STRESS_TMP_DIR="$(mktemp -d)"

	if [[ -z "$SSH_IDENTITY_FILE" ]]; then
		SSH_IDENTITY_FILE="${STRESS_TMP_DIR}/id_ed25519"
		ssh-keygen -q -t ed25519 -N '' -C "$RUN_ID" -f "$SSH_IDENTITY_FILE"
	fi
	SSH_PUBLIC_KEY="$(ssh-keygen -y -P '' -f "$SSH_IDENTITY_FILE")" ||
		fail "unable to read an unencrypted private key from ${SSH_IDENTITY_FILE}"

	CLOUD_INIT_USER_DATA="$(printf '%s\n' \
		'#cloud-config' \
		"password: ${CLOUD_INIT_PASSWORD}" \
		'chpasswd: { expire: False }' \
		'ssh_pwauth: True' \
		'ssh_authorized_keys:' \
		"- ${SSH_PUBLIC_KEY}" \
		'package_update: true' \
		'packages:' \
		'- qemu-guest-agent' \
		'runcmd:' \
		'- [systemctl, enable, --now, qemu-guest-agent.service]')"

	CLOUD_INIT_NETWORK_DATA="$(printf '%s\n' \
		'network:' \
		'  ethernets:' \
		"    ${GUEST_INTERFACE_NAME}:" \
		'      dhcp4: true' \
		'      dhcp6: true' \
		'      dhcp-identifier: mac' \
		'  version: 2')"
fi

wait_for_resource() {
	local resource="$1"
	local name="$2"
	local expression="$3"
	local description="$4"
	local failure_expression="${5:-false}"
	local failure_grace_seconds="${6:-0}"
	local deadline=$((SECONDS + TIMEOUT_SECONDS))
	local failure_first_seen=-1
	local failure_elapsed=0
	local failure_message=""
	local object=""

	log "Waiting for ${description}: ${resource}/${name}"
	while ((SECONDS < deadline)); do
		if object="$(kubectl get "$resource" "$name" -n "$NAMESPACE" -o json 2>/dev/null)"; then
			if jq -e "$expression" >/dev/null 2>&1 <<<"$object"; then
				if ((failure_first_seen >= 0)); then
					failure_elapsed=$((SECONDS - failure_first_seen))
					log "Ready after recovering from a transient ${description} error (${failure_elapsed}s): ${resource}/${name}"
				else
					log "Ready: ${resource}/${name}"
				fi
				return 0
			fi
			if jq -e "$failure_expression" >/dev/null 2>&1 <<<"$object"; then
				if ((failure_first_seen < 0)); then
					failure_first_seen=$SECONDS
					failure_message="$(jq -r '.status.error.message? // empty' <<<"$object" | tr '\n' ' ')"
					failure_message="${failure_message:0:1000}"
					if ((failure_grace_seconds > 0)); then
						log "Transient ${description} error reported; allowing ${failure_grace_seconds}s for controller recovery: ${resource}/${name}" >&2
						[[ -z "$failure_message" ]] || log "Transient error: ${failure_message}" >&2
					fi
				fi

				failure_elapsed=$((SECONDS - failure_first_seen))
				if ((failure_elapsed >= failure_grace_seconds)); then
					log "${description} failed after its error persisted for ${failure_elapsed}s: ${resource}/${name}" >&2
					kubectl get "$resource" "$name" -n "$NAMESPACE" -o yaml >&2 2>/dev/null || true
					return 1
				fi
			elif ((failure_first_seen >= 0)); then
				failure_elapsed=$((SECONDS - failure_first_seen))
				log "Transient ${description} error cleared after ${failure_elapsed}s; continuing to wait: ${resource}/${name}"
				failure_first_seen=-1
				failure_message=""
			fi
		fi
		sleep "$POLL_INTERVAL_SECONDS"
	done

	log "Timed out waiting for ${resource}/${name}; current state follows" >&2
	kubectl get "$resource" "$name" -n "$NAMESPACE" -o yaml >&2 2>/dev/null || true
	return 1
}

launcher_pod_json() {
	local vm_name="$1"
	kubectl get pods -n "$NAMESPACE" -o json | jq -c --arg vm "$vm_name" '
        [
          .items[]
          | select(.metadata.deletionTimestamp == null)
          | select(.metadata.labels["kubevirt.io"] == "virt-launcher")
          | select(
              .metadata.labels["vm.kubevirt.io/name"] == $vm or
              .metadata.labels["kubevirt.io/domain"] == $vm
            )
        ]
        | sort_by(.metadata.creationTimestamp)
        | last // empty
      '
}

wait_for_launcher_absent() {
	local vm_name="$1"
	local deadline=$((SECONDS + TIMEOUT_SECONDS))

	log "Waiting for the virt-launcher pod for VM ${vm_name} to stop"
	while ((SECONDS < deadline)); do
		if [[ -z "$(launcher_pod_json "$vm_name")" ]]; then
			return 0
		fi
		sleep "$POLL_INTERVAL_SECONDS"
	done

	log "Timed out waiting for VM ${vm_name} to stop" >&2
	return 1
}

virtctl_ssh() {
	local vm_name="$1"
	local command="$2"

	virtctl ssh \
		--namespace "$NAMESPACE" \
		--username "$SSH_USER" \
		--identity-file "$SSH_IDENTITY_FILE" \
		--known-hosts /dev/null \
		--local-ssh-opts="-o StrictHostKeyChecking=no" \
		--local-ssh-opts="-o BatchMode=yes" \
		--local-ssh-opts="-o ConnectTimeout=${SSH_CONNECT_TIMEOUT_SECONDS}" \
		--command "$command" \
		"vm/${vm_name}"
}

run_ssh_probe() {
	local vm_name="$1"
	local command="$2"
	local output=""
	local exit_code=0

	if output="$(virtctl_ssh "$vm_name" "$command" 2>&1)"; then
		LAST_SSH_ERROR=""
		return 0
	else
		exit_code=$?
	fi
	LAST_SSH_ERROR="$(sed -E 's/\x1B\[[0-9;]*[[:alpha:]]//g; s/\r$//' <<<"$output" | tail -n 12)"
	return "$exit_code"
}

log_last_ssh_error() {
	local line=""

	if [[ -z "$LAST_SSH_ERROR" ]]; then
		log "Last SSH probe produced no error output" >&2
		return
	fi
	while IFS= read -r line; do
		[[ -n "$line" ]] && log "Last SSH probe: ${line}" >&2
	done <<<"$LAST_SSH_ERROR"
}

wait_for_ssh_stage() {
	local vm_name="$1"
	local deadline="$2"
	local stage="$3"
	local command="$4"
	local success_message="$5"
	local started_at=$SECONDS
	local next_progress_at=$((SECONDS + 60))
	local remaining=0

	SSH_FAILURE_STAGE="$stage"
	log "Waiting for guest readiness stage '${stage}' on VM ${vm_name}"
	while ((SECONDS < deadline)); do
		if run_ssh_probe "$vm_name" "$command"; then
			log "Ready: ${success_message} on VM ${vm_name}"
			SSH_FAILURE_STAGE=""
			return 0
		fi
		if ((SECONDS >= next_progress_at)); then
			remaining=$((deadline - SECONDS))
			if ((remaining < 0)); then
				remaining=0
			fi
			log "Still waiting for guest readiness stage '${stage}' on VM ${vm_name} ($((SECONDS - started_at))s elapsed, ${remaining}s remaining)"
			next_progress_at=$((SECONDS + 60))
		fi
		sleep "$POLL_INTERVAL_SECONDS"
	done

	log "Timed out during guest readiness stage '${stage}' on VM ${vm_name}" >&2
	log_last_ssh_error
	return 1
}

wait_for_guest_ssh() {
	local vm_name="$1"
	local deadline=$((SECONDS + SSH_TIMEOUT_SECONDS))
	local guest_addresses=""

	CURRENT_FAILURE_CATEGORY="guest-readiness-failure"
	SSH_FAILURE_STAGE=""
	LAST_SSH_ERROR=""
	guest_addresses="$(kubectl get virtualmachineinstances.kubevirt.io "$vm_name" -n "$NAMESPACE" -o json 2>/dev/null |
		jq -r '[.status.interfaces[]? | .ipAddress? // empty | select(. != "")] | unique | join(", ")' 2>/dev/null || true)"
	if [[ -n "$guest_addresses" ]]; then
		log "Guest-reported IP address(es) for VM ${vm_name}: ${guest_addresses}"
	else
		log "Guest IP address is not yet reported for VM ${vm_name}; continuing with virtctl SSH probes"
	fi

	wait_for_ssh_stage "$vm_name" "$deadline" \
		"ssh-connectivity-and-authentication" \
		"true" \
		"SSH connection and key authentication" || return 1
	wait_for_ssh_stage "$vm_name" "$deadline" \
		"required-guest-commands" \
		"for command in base64 bash; do command -v \"\$command\" >/dev/null || { echo \"required guest command not found: \$command\" >&2; exit 1; }; done" \
		"required guest commands" || return 1
	wait_for_ssh_stage "$vm_name" "$deadline" \
		"passwordless-sudo" \
		"sudo -n true" \
		"passwordless sudo" || return 1

	log "All guest readiness stages passed on VM ${vm_name}"
}

run_guest_script() {
	local vm_name="$1"
	local script="$2"
	shift 2

	local encoded_script=""
	local remote_command=""
	local argument=""
	local quoted_argument=""

	encoded_script="$(printf '%s' "$script" | base64 | tr -d '\n')"
	remote_command="printf '%s' '${encoded_script}' | base64 -d | sudo -n bash -s --"
	for argument in "$@"; do
		printf -v quoted_argument '%q' "$argument"
		remote_command+=" ${quoted_argument}"
	done

	virtctl_ssh "$vm_name" "$remote_command"
}

is_transient_ssh_failure() {
	local exit_code="$1"
	local output="$2"
	local normalized_output="${output,,}"

	if ((exit_code == 255)); then
		return 0
	fi
	case "$normalized_output" in
	*"exit status 255"* | \
		*"connection timed out during banner exchange"* | \
		*"websocket: close"* | \
		*"unexpected eof"* | \
		*"broken pipe"* | \
		*"connection reset by peer"* | \
		*"connection closed by"* | \
		*"connect: connection refused"* | \
		*"internal error occurred: dialing vm"* | \
		*"tls handshake timeout"* | \
		*"i/o timeout"* | \
		*"context deadline exceeded"*)
		return 0
		;;
	esac
	return 1
}

run_guest_script_with_transport_retry() {
	local description="$1"
	local vm_name="$2"
	local script="$3"
	shift 3

	local deadline=$((SECONDS + SSH_TIMEOUT_SECONDS))
	local error_file=""
	local error_output=""
	local exit_code=0
	local output=""
	local remaining=0
	local retry_delay=0
	local retry_count=0
	local transient_summary=""

	error_file="$(mktemp "${STRESS_TMP_DIR}/verification-ssh.XXXXXX")"
	while true; do
		if output="$(run_guest_script "$vm_name" "$script" "$@" 2>"$error_file")"; then
			if [[ -s "$error_file" ]]; then
				cat "$error_file" >&2
			fi
			rm -f -- "$error_file"
			if ((retry_count > 0)); then
				log "Completed ${description} after ${retry_count} transient SSH retry(s)" >&2
			fi
			printf '%s\n' "$output"
			return 0
		else
			exit_code=$?
		fi

		error_output="$(<"$error_file")"
		if ! is_transient_ssh_failure "$exit_code" "${output}"$'\n'"${error_output}"; then
			[[ -z "$output" ]] || printf '%s\n' "$output" >&2
			[[ -z "$error_output" ]] || printf '%s\n' "$error_output" >&2
			rm -f -- "$error_file"
			return "$exit_code"
		fi

		transient_summary="$(printf '%s\n%s\n' "$output" "$error_output" |
			sed -E 's/\x1B\[[0-9;]*[[:alpha:]]//g; s/\r$//' |
			sed '/^[[:space:]]*$/d' | tail -n 1)"
		remaining=$((deadline - SECONDS))
		if ((remaining <= 0)); then
			log "Unable to complete ${description}: transient SSH failure persisted for ${SSH_TIMEOUT_SECONDS}s" >&2
			[[ -z "$transient_summary" ]] || log "Last SSH error: ${transient_summary}" >&2
			rm -f -- "$error_file"
			return 75
		fi

		retry_count=$((retry_count + 1))
		retry_delay=$POLL_INTERVAL_SECONDS
		if ((retry_delay > remaining)); then
			retry_delay=$remaining
		fi
		log "Transient SSH failure during ${description}; retry ${retry_count} in ${retry_delay}s (${remaining}s remaining)" >&2
		[[ -z "$transient_summary" ]] || log "SSH error: ${transient_summary}" >&2
		sleep "$retry_delay"
	done
}

write_root_payload() {
	local vm_name="$1"
	local payload_name="$2"
	local size_mib=$((ROOT_DATA_SIZE_GIB * 1024))

	run_guest_script_with_transport_retry "source root-disk payload write" "$vm_name" 'set -Eeuo pipefail

payload_directory="$1"
payload_name="$2"
size_mib="$3"

for command in cut dd df findmnt flock mkdir sha256sum sync tail; do
  command -v "$command" >/dev/null || { echo "required guest command not found: $command" >&2; exit 1; }
done

mkdir -p /run/lock
exec 9>"/run/lock/csi-stress-root-payload.lock"
flock 9

mkdir -p "$payload_directory"
mount_target="$(findmnt -rn -T "$payload_directory" -o TARGET)"
mount_source="$(findmnt -rn -T "$payload_directory" -o SOURCE)"
if [[ "$mount_target" != "/" ]]; then
  echo "root payload directory is mounted on $mount_target, not the root filesystem" >&2
  exit 1
fi

payload_path="${payload_directory}/${payload_name}"
payload_bytes=$((size_mib * 1024 * 1024))
available_bytes="$(df --output=avail -B1 "$payload_directory" | tail -n 1)"
if ((available_bytes < payload_bytes)); then
  echo "insufficient root-filesystem space: need $payload_bytes bytes, have $available_bytes bytes" >&2
  exit 1
fi
dd if=/dev/urandom of="$payload_path" bs=1M count="$size_mib" conv=fsync status=none >&2
sync
sha256sum "$payload_path" | cut -d " " -f1
' "$ROOT_PAYLOAD_DIRECTORY" "$payload_name" "$size_mib"
}

read_root_payload() {
	local vm_name="$1"
	local payload_name="$2"

	run_guest_script_with_transport_retry "restored root-disk checksum" "$vm_name" 'set -Eeuo pipefail

payload_directory="$1"
payload_name="$2"

for command in cut findmnt sha256sum; do
  command -v "$command" >/dev/null || { echo "required guest command not found: $command" >&2; exit 1; }
done
test -d "$payload_directory" || { echo "restored root payload directory not found: $payload_directory" >&2; exit 1; }
mount_target="$(findmnt -rn -T "$payload_directory" -o TARGET)"
if [[ "$mount_target" != "/" ]]; then
  echo "restored root payload directory is mounted on $mount_target, not the root filesystem" >&2
  exit 1
fi

payload_path="${payload_directory}/${payload_name}"
test -f "$payload_path" || { echo "restored root payload not found: $payload_path" >&2; exit 1; }
sha256sum "$payload_path" | cut -d " " -f1
' "$ROOT_PAYLOAD_DIRECTORY" "$payload_name"
}

write_guest_payload() {
	local vm_name="$1"
	local payload_name="$2"
	local device="$3"
	local mount_path="$4"
	local size_mib=$((DATA_SIZE_GIB * 1024))

	run_guest_script_with_transport_retry "source data-disk payload write" "$vm_name" 'set -Eeuo pipefail

device="$1"
mount_path="$2"
payload_name="$3"
size_mib="$4"

for command in blkid cut dd df findmnt flock grep head lsblk mkdir mkfs.ext4 mount mountpoint readlink sha256sum sync tail wipefs; do
  command -v "$command" >/dev/null || { echo "required guest command not found: $command" >&2; exit 1; }
done
test -b "$device" || { echo "guest data device is not a block device: $device" >&2; exit 1; }

mkdir -p /run/lock
exec 9>"/run/lock/csi-stress-data-payload.lock"
flock 9

device_real="$(readlink -f "$device")"
root_source="$(findmnt -n -o SOURCE /)"
if lsblk -sno PATH "$root_source" | grep -Fxq "$device_real"; then
  echo "refusing to use root-disk device: $device_real" >&2
  exit 1
fi

set +e
fs_type="$(blkid -p -s TYPE -o value "$device_real" 2>/dev/null)"
blkid_exit_code=$?
set -e
case "$blkid_exit_code" in
0)
  if [[ "$fs_type" != "ext4" ]]; then
    echo "guest data device has unsupported filesystem $fs_type; expected ext4" >&2
    exit 1
  fi
  ;;
2)
  signatures="$(wipefs --no-act --noheadings --output TYPE "$device_real")"
  if [[ -n "${signatures//[[:space:]]/}" ]]; then
    echo "guest data device has an unrecognized signature; refusing to format" >&2
    exit 1
  fi
  mkfs.ext4 -F "$device_real" >&2
  ;;
8)
  echo "guest data device has ambiguous signatures; refusing to format" >&2
  exit 1
  ;;
*)
  echo "unable to detect the guest data filesystem; blkid exited with $blkid_exit_code" >&2
  exit 1
  ;;
esac

mkdir -p "$mount_path"
existing_target="$(findmnt -rn -S "$device_real" -o TARGET | head -n 1 || true)"
if [[ -n "$existing_target" && "$existing_target" != "$mount_path" ]]; then
  echo "guest data device is already mounted at $existing_target" >&2
  exit 1
fi
if mountpoint -q "$mount_path"; then
  mounted_source="$(findmnt -rn -T "$mount_path" -o SOURCE)"
  if [[ "$(readlink -f "$mounted_source")" != "$device_real" ]]; then
    echo "guest mount path is occupied by $mounted_source, not $device_real" >&2
    exit 1
  fi
else
  mount "$device_real" "$mount_path"
fi

payload_path="${mount_path}/${payload_name}"
payload_bytes=$((size_mib * 1024 * 1024))
available_bytes="$(df --output=avail -B1 "$mount_path" | tail -n 1)"
if ((available_bytes < payload_bytes)); then
  echo "insufficient guest data-disk space: need $payload_bytes bytes, have $available_bytes bytes" >&2
  exit 1
fi
dd if=/dev/urandom of="$payload_path" bs=1M count="$size_mib" conv=fsync status=none >&2
sync
sha256sum "$payload_path" | cut -d " " -f1
' "$device" "$mount_path" "$payload_name" "$size_mib"
}

read_guest_payload() {
	local vm_name="$1"
	local payload_name="$2"
	local device="$3"
	local mount_path="$4"

	run_guest_script_with_transport_retry "restored data-disk checksum" "$vm_name" 'set -Eeuo pipefail

device="$1"
mount_path="$2"
payload_name="$3"

for command in blkid cut findmnt head mkdir mount mountpoint readlink sha256sum; do
  command -v "$command" >/dev/null || { echo "required guest command not found: $command" >&2; exit 1; }
done
test -b "$device" || { echo "guest data device is not a block device: $device" >&2; exit 1; }
device_real="$(readlink -f "$device")"
fs_type="$(blkid -p -s TYPE -o value "$device_real")"
[[ "$fs_type" == "ext4" ]] || { echo "restored guest data device is not ext4: $fs_type" >&2; exit 1; }

mkdir -p "$mount_path"
existing_target="$(findmnt -rn -S "$device_real" -o TARGET | head -n 1 || true)"
if [[ -n "$existing_target" && "$existing_target" != "$mount_path" ]]; then
  echo "restored guest data device is already mounted at $existing_target" >&2
  exit 1
fi
if mountpoint -q "$mount_path"; then
  mounted_source="$(findmnt -rn -T "$mount_path" -o SOURCE)"
  if [[ "$(readlink -f "$mounted_source")" != "$device_real" ]]; then
    echo "restored guest mount path is occupied by $mounted_source, not $device_real" >&2
    exit 1
  fi
else
  mount "$device_real" "$mount_path"
fi

payload_path="${mount_path}/${payload_name}"
test -f "$payload_path" || { echo "restored payload not found: $payload_path" >&2; exit 1; }
sha256sum "$payload_path" | cut -d " " -f1
' "$device" "$mount_path" "$payload_name"
}

verify_status_volumes() {
	local resource="$1"
	local name="$2"
	local status_field="$3"
	local description="$4"
	local expected=""
	local expected_list=""
	local object=""
	local actual=""

	expected="$(expected_volume_names)"
	object="$(kubectl get "$resource" "$name" -n "$NAMESPACE" -o json)"
	if jq -e --arg field "$status_field" --argjson expected "$expected" '
      ([.status[$field][]?.volumeName] | sort) == ($expected | sort)
    ' <<<"$object" >/dev/null; then
		log "${description} contains all $((DATA_VOLUME_COUNT + 1)) expected VM volumes"
		return
	fi

	actual="$(jq -r --arg field "$status_field" '
      [.status[$field][]?.volumeName] | sort | join(", ")
    ' <<<"$object")"
	expected_list="$(jq -r 'join(", ")' <<<"$expected")"
	fail "${description} volume set is incomplete:" \
		"expected ${expected_list}; got ${actual:-none}"
}

delete_resource_checked() {
	local resource="$1"
	local name="$2"

	[[ -n "$name" ]] || return 0
	if ! kubectl delete "$resource" "$name" -n "$NAMESPACE" \
		--ignore-not-found --wait=true --timeout="${TIMEOUT_SECONDS}s" >/dev/null; then
		log "WARNING: failed to delete ${resource}/${name}" >&2
		return 1
	fi
}

delete_resource() {
	delete_resource_checked "$@" || true
}

label_boot_storage_resources() {
	local name="$1"
	local iteration="$2"
	local labels=(
		"${STRESS_RUN_LABEL}=${RUN_ID}"
		"${STRESS_ITERATION_LABEL}=${iteration}"
	)

	kubectl label pvc "$name" -n "$NAMESPACE" "${labels[@]}" --overwrite >/dev/null
	if kubectl get datavolumes.cdi.kubevirt.io "$name" -n "$NAMESPACE" >/dev/null 2>&1; then
		kubectl label datavolumes.cdi.kubevirt.io "$name" -n "$NAMESPACE" \
			"${labels[@]}" --overwrite >/dev/null
	fi
}

label_restored_resources() {
	local vm_name="$1"
	local iteration="$2"
	local labels=(
		"${STRESS_RUN_LABEL}=${RUN_ID}"
		"${STRESS_ITERATION_LABEL}=${iteration}"
	)
	local template_label_patch=""
	local claim_name=""

	kubectl label virtualmachines.kubevirt.io "$vm_name" -n "$NAMESPACE" \
		"${labels[@]}" --overwrite >/dev/null
	template_label_patch="$(jq -nc \
		--arg runLabel "$STRESS_RUN_LABEL" \
		--arg run "$RUN_ID" \
		--arg iterationLabel "$STRESS_ITERATION_LABEL" \
		--arg iteration "$iteration" '
          {
            spec: {
              template: {
                metadata: {
                  labels: {
                    ($runLabel): $run,
                    ($iterationLabel): $iteration
                  }
                }
              }
            }
          }
        ')"
	kubectl patch virtualmachines.kubevirt.io "$vm_name" -n "$NAMESPACE" \
		--type merge -p "$template_label_patch" >/dev/null

	if kubectl get virtualmachineinstances.kubevirt.io "$vm_name" -n "$NAMESPACE" >/dev/null 2>&1; then
		kubectl label virtualmachineinstances.kubevirt.io "$vm_name" -n "$NAMESPACE" \
			"${labels[@]}" --overwrite >/dev/null
	fi

	while IFS= read -r claim_name; do
		[[ -n "$claim_name" ]] || continue
		kubectl label pvc "$claim_name" -n "$NAMESPACE" "${labels[@]}" --overwrite >/dev/null
		if kubectl get datavolumes.cdi.kubevirt.io "$claim_name" -n "$NAMESPACE" >/dev/null 2>&1; then
			kubectl label datavolumes.cdi.kubevirt.io "$claim_name" -n "$NAMESPACE" \
				"${labels[@]}" --overwrite >/dev/null
		fi
	done < <(
		kubectl get virtualmachines.kubevirt.io "$vm_name" -n "$NAMESPACE" -o json |
			jq -r '.spec.template.spec.volumes[]?.persistentVolumeClaim.claimName? // empty'
	)
}

delete_resources_by_selector() {
	local resource="$1"
	local selector="$2"

	kubectl delete "$resource" -n "$NAMESPACE" -l "$selector" \
		--ignore-not-found --wait=true --timeout="${TIMEOUT_SECONDS}s" >/dev/null ||
		log "WARNING: failed to delete one or more ${resource} resources" >&2
}

delete_resources_by_name_prefix() {
	local resource="$1"
	local prefix="$2"
	local name=""

	while IFS= read -r name; do
		[[ -n "$name" ]] || continue
		delete_resource "$resource" "$name"
	done < <(
		kubectl get "$resource" -n "$NAMESPACE" -o json |
			jq -r --arg prefix "$prefix" '.items[].metadata.name | select(startswith($prefix))'
	)
}

cleanup_old_runs() {
	local selector="$STRESS_RUN_LABEL"
	local resource_set="virtualmachineimages.harvesterhci.io,virtualmachinebackups.harvesterhci.io,virtualmachinerestores.harvesterhci.io,virtualmachines.kubevirt.io,virtualmachineinstances.kubevirt.io,volumesnapshots.snapshot.storage.k8s.io,datavolumes.cdi.kubevirt.io,pvc,pods"
	local name_prefix="csi-stress-"
	local restore_storage_prefix="restore-csi-stress-"
	local restore_name=""
	local target_vm=""
	local remaining=""
	local cleanup_failed=false

	if [[ -n "$CLEANUP_RUN_ID" ]]; then
		selector="${STRESS_RUN_LABEL}=${CLEANUP_RUN_ID}"
		name_prefix="$CLEANUP_RUN_ID"
		restore_storage_prefix="restore-${CLEANUP_RUN_ID}-"
	fi

	kubectl get namespace "$NAMESPACE" >/dev/null
	log "Stress-test resources selected by ${selector@Q} in namespace ${NAMESPACE}:"
	kubectl get "$resource_set" -n "$NAMESPACE" -l "$selector" -o wide || true
	log "Unlabeled stress-test resources selected by name prefix ${name_prefix@Q}:"
	kubectl get virtualmachineimages.harvesterhci.io,virtualmachines.kubevirt.io,virtualmachineinstances.kubevirt.io,datavolumes.cdi.kubevirt.io,pvc -n "$NAMESPACE" -o json |
		jq -r --arg prefix "$name_prefix" --arg restorePrefix "$restore_storage_prefix" '
          .items[]
          | select(
              (.metadata.name | startswith($prefix)) or
              (.metadata.name | startswith($restorePrefix))
            )
          | [.kind, .metadata.name, (.status.phase // "")]
          | @tsv
        '

	# A restored VM may not retain the stress-test labels. Resolve and delete each
	# target from the labeled restore before removing the restore itself.
	while IFS=$'\t' read -r restore_name target_vm; do
		[[ -n "$restore_name" ]] || continue
		delete_resource virtualmachines.kubevirt.io "$target_vm"
		if [[ -n "$target_vm" ]] && kubectl get virtualmachines.kubevirt.io "$target_vm" \
			-n "$NAMESPACE" >/dev/null 2>&1; then
			log "WARNING: restored VM ${target_vm} still exists" >&2
			cleanup_failed=true
		fi
	done < <(
		kubectl get virtualmachinerestores.harvesterhci.io -n "$NAMESPACE" \
			-l "$selector" -o json |
			jq -r '.items[] | [.metadata.name, (.spec.target.name // "")] | @tsv'
	)

	delete_resources_by_selector virtualmachinerestores.harvesterhci.io "$selector"
	# Delete backups while their source VMs and PVCs still exist so snapshot
	# topology can be resolved by the CSI driver.
	delete_resources_by_selector virtualmachinebackups.harvesterhci.io "$selector"
	# Remove any labeled VolumeSnapshot left behind by an interrupted controller.
	delete_resources_by_selector volumesnapshots.snapshot.storage.k8s.io "$selector"
	delete_resources_by_selector virtualmachines.kubevirt.io "$selector"
	delete_resources_by_name_prefix virtualmachines.kubevirt.io "$name_prefix"
	delete_resources_by_selector virtualmachineinstances.kubevirt.io "$selector"
	delete_resources_by_name_prefix virtualmachineinstances.kubevirt.io "$name_prefix"
	delete_resources_by_selector pods "$selector"
	delete_resources_by_selector virtualmachineimages.harvesterhci.io "$selector"
	delete_resources_by_name_prefix virtualmachineimages.harvesterhci.io "$name_prefix"
	delete_resources_by_selector datavolumes.cdi.kubevirt.io "$selector"
	delete_resources_by_name_prefix datavolumes.cdi.kubevirt.io "$name_prefix"
	delete_resources_by_name_prefix datavolumes.cdi.kubevirt.io "$restore_storage_prefix"
	delete_resources_by_selector pvc "$selector"
	delete_resources_by_name_prefix pvc "$name_prefix"
	delete_resources_by_name_prefix pvc "$restore_storage_prefix"

	if ! remaining="$(kubectl get "$resource_set" -n "$NAMESPACE" -l "$selector" -o name)"; then
		log "Unable to verify cleanup results" >&2
		return 1
	fi
	if [[ -n "$remaining" ]]; then
		log "Cleanup finished with resources still present:" >&2
		printf '%s\n' "$remaining" >&2
		return 1
	fi
	remaining="$(kubectl get virtualmachineimages.harvesterhci.io,virtualmachines.kubevirt.io,virtualmachineinstances.kubevirt.io,datavolumes.cdi.kubevirt.io,pvc -n "$NAMESPACE" -o json |
		jq -r --arg prefix "$name_prefix" --arg restorePrefix "$restore_storage_prefix" '
          .items[].metadata.name
          | select(startswith($prefix) or startswith($restorePrefix))
        ')"
	if [[ -n "$remaining" ]]; then
		log "Cleanup finished with CDI storage still present:" >&2
		printf '%s\n' "$remaining" >&2
		return 1
	fi
	if [[ "$cleanup_failed" == true ]]; then
		return 1
	fi

	log "Cleanup completed; no labeled stress-test resources remain"
}

clear_iteration_state() {
	CURRENT_VM=""
	CURRENT_BACKUP=""
	CURRENT_BACKUP_TYPE=""
	CURRENT_RESTORE=""
	CURRENT_RESTORED_VM=""
	CURRENT_ITERATION=""
	CURRENT_BOOT_PVC=""
	CURRENT_DIAGNOSTICS_COLLECTED=false
}

vm_backup_type_for_iteration() {
	local worker="$1"
	local iteration="$2"
	local type_index=$(((worker + iteration - 2) % ${#VM_BACKUP_TYPE_LIST[@]}))

	printf '%s\n' "${VM_BACKUP_TYPE_LIST[$type_index]}"
}

validate_remote_engine_names() {
	local derived_name=""
	local index=0
	local pvc_name=""
	local volume_name=""

	case "$CURRENT_BACKUP_TYPE" in
	restic | kopia) ;;
	*) return 0 ;;
	esac

	for pvc_name in "$@"; do
		derived_name="${CURRENT_BACKUP_TYPE}-backup-${CURRENT_BACKUP}"
		derived_name+="-volume-${pvc_name}"
		((${#derived_name} <= 63)) ||
			fail "generated remote backup helper name exceeds 63 bytes: ${derived_name}"
	done
	for ((index = 0; index <= DATA_VOLUME_COUNT; index++)); do
		if ((index == 0)); then
			volume_name="boot-disk"
		else
			volume_name="$(data_volume_name "$index")"
		fi
		derived_name="${CURRENT_BACKUP_TYPE}-restore-${CURRENT_RESTORE}"
		derived_name+="-${volume_name}"
		((${#derived_name} <= 63)) ||
			fail "generated remote restore helper name exceeds 63 bytes: ${derived_name}"
	done
}

cleanup_iteration() {
	local cleanup_failed=false

	[[ -n "$CURRENT_ITERATION" ]] || return 0
	log "Cleaning resources from ${CURRENT_ITERATION}"

	# VirtualMachineRestore defaults to deletionPolicy=delete. Stop and remove
	# the target VM before deleting the restore CR and its restored PVCs.
	delete_resource_checked virtualmachines.kubevirt.io "$CURRENT_RESTORED_VM" || cleanup_failed=true
	delete_resource_checked virtualmachinerestores.harvesterhci.io "$CURRENT_RESTORE" || cleanup_failed=true
	# Remove the backup while the source VM and PVs still exist so the CSI driver
	# can resolve snapshot topology and delete every backend snapshot.
	delete_resource_checked virtualmachinebackups.harvesterhci.io "$CURRENT_BACKUP" || cleanup_failed=true
	delete_resource_checked virtualmachines.kubevirt.io "$CURRENT_VM" || cleanup_failed=true
	delete_resource_checked datavolumes.cdi.kubevirt.io "$CURRENT_BOOT_PVC" || cleanup_failed=true
	delete_resource_checked pvc "$CURRENT_BOOT_PVC" || cleanup_failed=true

	if ! kubectl delete pvc -n "$NAMESPACE" \
		-l "${STRESS_RUN_LABEL}=${RUN_ID},${STRESS_ITERATION_LABEL}=${CURRENT_ITERATION}" \
		--ignore-not-found --wait=true --timeout="${TIMEOUT_SECONDS}s" >/dev/null; then
		log "WARNING: failed to delete one or more iteration PVCs" >&2
		cleanup_failed=true
	fi
	if [[ "$cleanup_failed" == true ]]; then
		return 1
	fi

	clear_iteration_state
}

cleanup_image() {
	delete_resource virtualmachineimages.harvesterhci.io "$IMAGE_NAME"
}

dump_named_resource() {
	local resource="$1"
	local name="$2"

	[[ -n "$name" ]] || return 0
	if kubectl get "$resource" "$name" -n "$NAMESPACE" >/dev/null 2>&1; then
		log "Diagnostic YAML: ${resource}/${name}" >&2
		kubectl get "$resource" "$name" -n "$NAMESPACE" -o yaml >&2 2>/dev/null || true
	fi
}

dump_object_events() {
	local name="$1"

	[[ -n "$name" ]] || return 0
	log "Diagnostic events involving ${name}:" >&2
	kubectl get events -n "$NAMESPACE" \
		--field-selector "involvedObject.name=${name}" \
		--sort-by='.lastTimestamp' -o wide >&2 2>/dev/null || true
}

dump_cdi_pods() {
	local pods=""
	local pod=""

	pods="$(kubectl get pods -n "$NAMESPACE" -l app=containerized-data-importer \
		-o json 2>/dev/null | jq -r '.items[].metadata.name' 2>/dev/null || true)"
	while IFS= read -r pod; do
		[[ -n "$pod" ]] || continue
		log "CDI diagnostic status: pod/${pod}" >&2
		kubectl get pod "$pod" -n "$NAMESPACE" -o json 2>/dev/null |
			jq '{metadata: {name: .metadata.name, namespace: .metadata.namespace,
              labels: .metadata.labels, annotations: .metadata.annotations,
              creationTimestamp: .metadata.creationTimestamp,
              ownerReferences: .metadata.ownerReferences}, status: .status}' >&2 || true
		log "Last 200 log lines from CDI pod/${pod}:" >&2
		kubectl logs "$pod" -n "$NAMESPACE" --all-containers \
			--tail=200 --timestamps --prefix >&2 2>/dev/null || true
		log "Previous log lines from CDI pod/${pod}:" >&2
		kubectl logs "$pod" -n "$NAMESPACE" --all-containers --previous \
			--tail=200 --timestamps --prefix >&2 2>/dev/null || true
		dump_object_events "$pod"
	done <<<"$pods"
}

dump_iteration_diagnostics() {
	local selector="${STRESS_RUN_LABEL}=${RUN_ID},${STRESS_ITERATION_LABEL}=${CURRENT_ITERATION}"
	local launcher_pods=""
	local pod=""
	local container=""
	local pvc_names=""
	local claim=""
	local pv=""

	CURRENT_DIAGNOSTICS_COLLECTED=true
	log "Failure category: ${CURRENT_FAILURE_CATEGORY:-iteration-failure}" >&2
	if [[ -n "$SSH_FAILURE_STAGE" ]]; then
		log "Guest readiness stage at failure: ${SSH_FAILURE_STAGE}" >&2
	fi
	log "Collecting diagnostics before cleanup for ${CURRENT_ITERATION}" >&2
	log "Resources selected by ${selector@Q}:" >&2
	kubectl get \
		virtualmachinebackups.harvesterhci.io,virtualmachinerestores.harvesterhci.io,virtualmachines.kubevirt.io,virtualmachineinstances.kubevirt.io,datavolumes.cdi.kubevirt.io,pvc,pods \
		-n "$NAMESPACE" -l "$selector" -o wide >&2 2>/dev/null || true

	dump_named_resource virtualmachines.kubevirt.io "$CURRENT_VM"
	dump_named_resource virtualmachineinstances.kubevirt.io "$CURRENT_VM"
	dump_named_resource virtualmachinebackups.harvesterhci.io "$CURRENT_BACKUP"
	dump_named_resource virtualmachinerestores.harvesterhci.io "$CURRENT_RESTORE"
	dump_named_resource virtualmachines.kubevirt.io "$CURRENT_RESTORED_VM"
	dump_named_resource virtualmachineinstances.kubevirt.io "$CURRENT_RESTORED_VM"
	dump_named_resource datavolumes.cdi.kubevirt.io "$CURRENT_BOOT_PVC"
	dump_cdi_pods

	launcher_pods="$(kubectl get pods -n "$NAMESPACE" -o json 2>/dev/null |
		jq -r --arg source "$CURRENT_VM" --arg restored "$CURRENT_RESTORED_VM" '
          .items[]
          | select(.metadata.labels["kubevirt.io"] == "virt-launcher")
          | select(
              .metadata.labels["vm.kubevirt.io/name"] == $source or
              .metadata.labels["kubevirt.io/domain"] == $source or
              .metadata.labels["vm.kubevirt.io/name"] == $restored or
              .metadata.labels["kubevirt.io/domain"] == $restored
            )
          | .metadata.name
        ' 2>/dev/null || true)"
	while IFS= read -r pod; do
		[[ -n "$pod" ]] || continue
		log "Diagnostic description: pod/${pod}" >&2
		kubectl describe pod "$pod" -n "$NAMESPACE" >&2 2>/dev/null || true
		for container in compute guest-console-log; do
			if kubectl get pod "$pod" -n "$NAMESPACE" -o json 2>/dev/null |
				jq -e --arg container "$container" '
                  [.spec.containers[]?, .spec.initContainers[]?]
                  | any(.name == $container)
                ' >/dev/null 2>&1; then
				log "Last 200 log lines from pod/${pod} container ${container}:" >&2
				kubectl logs "$pod" -n "$NAMESPACE" -c "$container" --tail=200 --timestamps >&2 2>/dev/null || true
			fi
		done
		dump_object_events "$pod"
	done <<<"$launcher_pods"

	pvc_names="$(
		{
			kubectl get pvc -n "$NAMESPACE" -l "$selector" -o json 2>/dev/null |
				jq -r '.items[].metadata.name' 2>/dev/null || true
			if [[ -n "$CURRENT_RESTORE" ]]; then
				kubectl get virtualmachinerestores.harvesterhci.io "$CURRENT_RESTORE" -n "$NAMESPACE" -o json 2>/dev/null |
					jq -r '.status.restores[]?.persistentVolumeClaimSpec.metadata.name // empty' 2>/dev/null || true
			fi
			[[ -n "$CURRENT_BOOT_PVC" ]] && printf '%s\n' "$CURRENT_BOOT_PVC"
		} | sort -u
	)"
	while IFS= read -r claim; do
		[[ -n "$claim" ]] || continue
		dump_named_resource pvc "$claim"
		dump_object_events "$claim"
		pv="$(kubectl get pvc "$claim" -n "$NAMESPACE" -o jsonpath='{.spec.volumeName}' 2>/dev/null || true)"
		if [[ -n "$pv" ]]; then
			log "Diagnostic YAML: persistentvolume/${pv}" >&2
			kubectl get persistentvolume "$pv" -o yaml >&2 2>/dev/null || true
			log "VolumeAttachment state for persistentvolume/${pv}:" >&2
			kubectl get volumeattachments.storage.k8s.io -o json 2>/dev/null |
				jq --arg pv "$pv" '[.items[] | select(.spec.source.persistentVolumeName == $pv) | {
                  name: .metadata.name,
                  attacher: .spec.attacher,
                  nodeName: .spec.nodeName,
                  attached: .status.attached,
                  attachError: .status.attachError,
                  detachError: .status.detachError
                }]' >&2 2>/dev/null || true
		fi
	done <<<"$pvc_names"

	for pod in "$CURRENT_VM" "$CURRENT_RESTORED_VM" "$CURRENT_BACKUP" "$CURRENT_RESTORE"; do
		dump_object_events "$pod"
	done
	log "Finished diagnostics for ${CURRENT_ITERATION}" >&2
}

cdi_clone_source_pod() {
	local pvc="$1"

	kubectl get pvc "$pvc" -n "$NAMESPACE" -o json 2>/dev/null |
		jq -r '.metadata.annotations["cdi.kubevirt.io/storage.sourceClonePodName"] // empty'
}

cdi_clone_auth_failed() {
	local pvc="$1"
	local pod=""
	local logs=""
	local previous_logs=""

	pod="$(cdi_clone_source_pod "$pvc" || true)"
	[[ -n "$pod" ]] || return 1

	logs="$(kubectl logs "$pod" -n "$NAMESPACE" --all-containers \
		--tail=200 2>/dev/null || true)"
	previous_logs="$(kubectl logs "$pod" -n "$NAMESPACE" --all-containers \
		--previous --tail=200 2>/dev/null || true)"
	if [[ "$logs" != *"Unexpected status code 401"* &&
		"$previous_logs" != *"Unexpected status code 401"* ]]; then
		return 1
	fi

	log "Detected CDI clone authentication failure in pod ${NAMESPACE}/${pod}" >&2
	return 0
}

cdi_signer_ready() {
	local signer=""
	local signer_namespace=""
	local signer_data=""
	local signer_cert=""
	local bundle=""

	signer="$(kubectl get secret -A \
		--field-selector metadata.name=cdi-uploadserver-client-signer \
		-o json 2>/dev/null | jq -r '
          [.items[] | select(.data["tls.crt"] != null)][0]
          | if . == null then empty
            else [.metadata.namespace, .data["tls.crt"]] | @tsv
            end
        ' 2>/dev/null || true)"
	[[ -n "$signer" ]] || return 1
	IFS=$'\t' read -r signer_namespace signer_data <<<"$signer"
	[[ -n "$signer_namespace" && -n "$signer_data" ]] || return 1

	signer_cert="$(printf '%s' "$signer_data" | base64 --decode 2>/dev/null)" ||
		return 1
	bundle="$(kubectl get configmap cdi-uploadserver-client-signer-bundle \
		-n "$signer_namespace" -o json 2>/dev/null |
		jq -r '.data["ca-bundle.crt"] // empty' 2>/dev/null || true)"
	[[ -n "$bundle" && "$bundle" == *"$signer_cert"* ]]
}

wait_for_cdi_signer() {
	local deadline=$((SECONDS + CDI_CERT_SYNC_TIMEOUT_SECONDS))

	log "Waiting for the CDI client signer bundle to contain the current signer"
	while ((SECONDS < deadline)); do
		if cdi_signer_ready; then
			log "CDI client signer bundle is synchronized"
			return 0
		fi
		sleep "$POLL_INTERVAL_SECONDS"
	done

	log "ERROR: CDI client signer bundle did not synchronize within ${CDI_CERT_SYNC_TIMEOUT_SECONDS}s" >&2
	return 1
}

retry_iteration() {
	local worker="$1"
	local iteration="$2"
	local attempt="$3"
	local vm_retries="$4"
	local cdi_retries="$5"
	local retry_kind="$6"
	local reason="$7"
	local next_vm_retries="$vm_retries"
	local next_cdi_retries="$cdi_retries"
	local max_attempts=$((SSH_VM_RETRIES + CDI_CLONE_RETRIES + 1))

	dump_iteration_diagnostics || true
	case "$retry_kind" in
	cdi)
		if ((cdi_retries >= CDI_CLONE_RETRIES)); then
			log "CDI clone retry budget exhausted for iteration ${iteration}" >&2
			return 1
		fi
		next_cdi_retries=$((cdi_retries + 1))
		;;
	vm)
		if ((vm_retries >= SSH_VM_RETRIES)); then
			return 1
		fi
		next_vm_retries=$((vm_retries + 1))
		;;
	*)
		log "ERROR: unknown iteration retry kind: ${retry_kind@Q}" >&2
		return 1
		;;
	esac

	log "${reason}; retrying iteration ${iteration} with a fresh VM (attempt $((attempt + 1))/${max_attempts})" >&2
	if ! cleanup_iteration; then
		log "ERROR: unable to clean attempt ${attempt}; not starting a conflicting retry" >&2
		return 1
	fi
	if [[ "$retry_kind" == cdi ]] && ! wait_for_cdi_signer; then
		return 1
	fi
	if run_iteration "$worker" "$iteration" "$((attempt + 1))" \
		"$next_vm_retries" "$next_cdi_retries"; then
		if [[ "$retry_kind" == cdi ]]; then
			log "Recovered iteration ${iteration} after a CDI clone authentication retry"
		fi
		return 0
	fi
	return 1
}

dump_diagnostics() {
	log "Stress-test resources at failure:" >&2
	kubectl get virtualmachineimages.harvesterhci.io,virtualmachinebackups.harvesterhci.io,virtualmachinerestores.harvesterhci.io,virtualmachines.kubevirt.io,pvc,pods \
		-n "$NAMESPACE" -l "${STRESS_RUN_LABEL}=${RUN_ID}" -o wide >&2 2>/dev/null || true
}

terminate_workers() {
	local pid=""

	((${#ACTIVE_PIDS[@]} > 0)) || return 0
	log "Stopping ${#ACTIVE_PIDS[@]} active iteration worker(s)"
	for pid in "${ACTIVE_PIDS[@]}"; do
		kill -TERM "$pid" 2>/dev/null || true
	done
	for pid in "${ACTIVE_PIDS[@]}"; do
		wait "$pid" 2>/dev/null || true
	done
	ACTIVE_PIDS=()
}

on_exit() {
	local exit_code=$?
	local keep_local_diagnostics=false
	trap - EXIT INT TERM
	terminate_workers

	if ((exit_code != 0)); then
		dump_diagnostics
	fi
	if [[ "$KEEP_RESOURCES" == true ]]; then
		log "Keeping resources with label ${STRESS_RUN_LABEL}=${RUN_ID}"
		keep_local_diagnostics=true
	elif ((exit_code != 0)) && [[ "$PARENT_SIGNALLED" == false ]] && [[ "$KEEP_FAILED_RESOURCES" == true ]]; then
		log "Keeping failed-iteration resources and shared image with label ${STRESS_RUN_LABEL}=${RUN_ID}"
		log "Use --cleanup-run ${RUN_ID} when investigation is complete"
		keep_local_diagnostics=true
	else
		if ((exit_code != 0)) && [[ -n "$RUN_ID" ]]; then
			# A parent process cannot see a background worker's shell-local state.
			# Sweep by the run label and generated-name prefixes after all workers stop.
			CLEANUP_RUN_ID="$RUN_ID"
			cleanup_old_runs || true
		else
			cleanup_iteration || true
			cleanup_image || true
		fi
	fi
	if [[ "$keep_local_diagnostics" == true ]] && [[ -n "$STRESS_TMP_DIR" && -d "$STRESS_TMP_DIR" ]]; then
		log "Keeping local diagnostics and SSH identity in ${STRESS_TMP_DIR}"
		log "Remove ${STRESS_TMP_DIR} manually after investigation"
	elif [[ -n "$STRESS_TMP_DIR" && -d "$STRESS_TMP_DIR" ]]; then
		rm -rf -- "$STRESS_TMP_DIR"
	fi
	exit "$exit_code"
}

if [[ "$CLEANUP_MODE" == true ]]; then
	if [[ -n "$CLEANUP_RUN_ID" ]]; then
		cleanup_old_runs
		exit 0
	fi
	cleanup_status=0
	cleanup_old_runs || cleanup_status=1
	"$(dirname "$0")/harvester-vmbackup-benchmark" \
		--cleanup-all --namespace "$NAMESPACE" \
		--kubeconfig "$KUBECONFIG_PATH" || cleanup_status=1
	exit "$cleanup_status"
fi

trap on_exit EXIT
trap 'PARENT_SIGNALLED=true; exit 130' INT
trap 'PARENT_SIGNALLED=true; exit 143' TERM

kubectl get namespace "$NAMESPACE" >/dev/null
kubectl get storageclass "$IMAGE_STORAGE_CLASS" >/dev/null
kubectl get storageclass "$DATA_STORAGE_CLASS" >/dev/null

NETWORK_NAMESPACE="$NAMESPACE"
NETWORK_RESOURCE_NAME="$NETWORK_NAME"
if [[ "$NETWORK_NAME" == */* ]]; then
	NETWORK_NAMESPACE="${NETWORK_NAME%%/*}"
	NETWORK_RESOURCE_NAME="${NETWORK_NAME#*/}"
fi
kubectl get network-attachment-definitions.k8s.cni.cncf.io "$NETWORK_RESOURCE_NAME" \
	-n "$NETWORK_NAMESPACE" >/dev/null

log "Run ID: ${RUN_ID}"
log "Boot PVC: ${BOOT_SIZE_GIB}Gi ${BOOT_VOLUME_MODE} ${BOOT_ACCESS_MODE} on ${IMAGE_STORAGE_CLASS}"
log "Data PVCs: ${DATA_VOLUME_COUNT} x ${DATA_VOLUME_SIZE_GIB}Gi" \
	"${DATA_VOLUME_MODE} ${DATA_ACCESS_MODE} on ${DATA_STORAGE_CLASS}"
log "Payloads: ${ROOT_DATA_SIZE_GIB}Gi on root; ${DATA_SIZE_GIB}Gi on each data disk"
log "VM network: ${NETWORK_NAME}; guest interface: ${GUEST_INTERFACE_NAME}"
log "VM backup types: ${VM_BACKUP_TYPES}"
log "Timeouts: cluster operations ${TIMEOUT_SECONDS}s; VM backup error grace ${SNAPSHOT_ERROR_GRACE_SECONDS}s"
log "SSH timeout: ${SSH_TIMEOUT_SECONDS}s; SSH connect: ${SSH_CONNECT_TIMEOUT_SECONDS}s"
log "Retry budgets: fresh VM ${SSH_VM_RETRIES}; CDI clone authentication ${CDI_CLONE_RETRIES}"

log "Creating VirtualMachineImage ${NAMESPACE}/${IMAGE_NAME}"
jq -n \
	--arg namespace "$NAMESPACE" \
	--arg name "$IMAGE_NAME" \
	--arg run "$RUN_ID" \
	--arg runLabel "$STRESS_RUN_LABEL" \
	--arg storageClass "$IMAGE_STORAGE_CLASS" \
	--arg url "$IMAGE_URL" '
  {
    apiVersion: "harvesterhci.io/v1beta1",
    kind: "VirtualMachineImage",
    metadata: {
      name: $name,
      namespace: $namespace,
      annotations: {"harvesterhci.io/storageClassName": $storageClass},
      labels: {
        ($runLabel): $run,
        "harvesterhci.io/image-type": "raw_qcow2",
        "harvesterhci.io/imageDisplayName": ($name + ".img")
      }
    },
    spec: {
      backend: "cdi",
      checksum: "",
      displayName: ($name + ".img"),
      pvcName: "",
      pvcNamespace: "",
      retry: 3,
      sourceType: "download",
      targetStorageClassName: $storageClass,
      url: $url
    }
  }
' | kubectl apply -f - >/dev/null

wait_for_resource virtualmachineimages.harvesterhci.io "$IMAGE_NAME" '
  any(.status.conditions[]?; .type == "Imported" and .status == "True")
' "VM image import" '
  any(.status.conditions[]?; .type == "RetryLimitExceeded" and .status == "True")
'

create_iteration_vm() {
	local iteration="$1"
	local vm_json="$2"
	local image_id="${NAMESPACE}/${IMAGE_NAME}"

	jq -n \
		--arg namespace "$NAMESPACE" \
		--arg vm "$CURRENT_VM" \
		--arg run "$RUN_ID" \
		--arg iteration "$iteration" \
		--arg runLabel "$STRESS_RUN_LABEL" \
		--arg iterationLabel "$STRESS_ITERATION_LABEL" \
		--arg templateAnnotation "$VOLUME_TEMPLATE_ANNOTATION" \
		--arg imageAnnotation "$IMAGE_ID_ANNOTATION" \
		--arg imageID "$image_id" \
		--arg bootStorageClass "$IMAGE_STORAGE_CLASS" \
		--arg dataStorageClass "$DATA_STORAGE_CLASS" \
		--arg bootSize "${BOOT_SIZE_GIB}Gi" \
		--arg dataSize "${DATA_VOLUME_SIZE_GIB}Gi" \
		--arg bootVolumeMode "$BOOT_VOLUME_MODE" \
		--arg dataVolumeMode "$DATA_VOLUME_MODE" \
		--arg bootAccessMode "$BOOT_ACCESS_MODE" \
		--arg dataAccessMode "$DATA_ACCESS_MODE" \
		--arg dataVolumePrefix "$DATA_VOLUME_PREFIX" \
		--arg dataSerialPrefix "$DATA_DISK_SERIAL_PREFIX" \
		--arg networkName "$NETWORK_NAME" \
		--arg nodeSelectorKey "$NODE_SELECTOR_KEY" \
		--arg nodeSelectorValue "$NODE_SELECTOR_VALUE" \
		--arg cloudInitUserData "$CLOUD_INIT_USER_DATA" \
		--arg cloudInitNetworkData "$CLOUD_INIT_NETWORK_DATA" \
		--arg memory "$MEMORY" \
		--argjson cpu "$CPU" \
		--argjson dataVolumeCount "$DATA_VOLUME_COUNT" '
    ($vm + "-pvc-0") as $bootPVC
    | [
        range(1; $dataVolumeCount + 1) as $index
        | {
            volumeName: ($dataVolumePrefix + "-" + ($index | tostring)),
            pvcName: ($vm + "-pvc-" + ($index | tostring)),
            serial: ($dataSerialPrefix + "-" + ($index | tostring))
          }
      ] as $dataVolumes
    | ([
        {
          metadata: {
            name: $bootPVC,
            annotations: {($imageAnnotation): $imageID},
            labels: {($runLabel): $run, ($iterationLabel): $iteration}
          },
          spec: {
            accessModes: [$bootAccessMode],
            resources: {requests: {storage: $bootSize}},
            volumeMode: $bootVolumeMode,
            storageClassName: $bootStorageClass
          }
        }
      ] + [
        $dataVolumes[]
        | {
          metadata: {
            name: .pvcName,
            labels: {($runLabel): $run, ($iterationLabel): $iteration}
          },
          spec: {
            accessModes: [$dataAccessMode],
            resources: {requests: {storage: $dataSize}},
            volumeMode: $dataVolumeMode,
            storageClassName: $dataStorageClass
          }
        }
      ]) as $volumeTemplates
    | {
        apiVersion: "kubevirt.io/v1",
        kind: "VirtualMachine",
        metadata: {
          name: $vm,
          namespace: $namespace,
          annotations: {
            ($templateAnnotation): ($volumeTemplates | tojson),
            "harvesterhci.io/vmRunStrategy": "RerunOnFailure"
          },
          labels: {
            ($runLabel): $run,
            ($iterationLabel): $iteration,
            "harvesterhci.io/creator": "harvester",
            "harvesterhci.io/os": "ubuntu"
          }
        },
        spec: {
          runStrategy: "RerunOnFailure",
          template: {
            metadata: {
              labels: {
                "harvesterhci.io/vmName": $vm,
                ($runLabel): $run,
                ($iterationLabel): $iteration
              }
            },
            spec: {
              architecture: "amd64",
              domain: {
                cpu: {cores: $cpu, sockets: 1, threads: 1, maxSockets: 1},
                devices: {
                  disks: (
                    [{name: "boot-disk", bootOrder: 1, disk: {bus: "virtio"}}]
                    + [
                        $dataVolumes[]
                        | {name: .volumeName, serial: .serial, disk: {bus: "virtio"}}
                      ]
                    + [{name: "cloudinitdisk", disk: {bus: "virtio"}}]
                  ),
                  interfaces: [
                    {name: "default", model: "virtio", bridge: {}}
                  ]
                },
                features: {acpi: {enabled: true}},
                machine: {type: "q35"},
                memory: {guest: $memory},
                resources: {
                  limits: {cpu: ($cpu | tostring), memory: $memory},
                  requests: {cpu: ($cpu | tostring), memory: $memory}
                }
              },
              hostname: $vm,
              networks: [
                {name: "default", multus: {networkName: $networkName}}
              ],
              terminationGracePeriodSeconds: 20,
              volumes: (
                [{name: "boot-disk", persistentVolumeClaim: {claimName: $bootPVC}}]
                + [
                    $dataVolumes[]
                    | {
                        name: .volumeName,
                        persistentVolumeClaim: {claimName: .pvcName}
                      }
                  ]
                + [{
                  name: "cloudinitdisk",
                  cloudInitNoCloud: {
                    userData: $cloudInitUserData,
                    networkData: $cloudInitNetworkData
                  }
                }]
              )
            }
          }
        }
      }
    | if $nodeSelectorKey != "" then
        .spec.template.spec.affinity = {
          nodeAffinity: {
            requiredDuringSchedulingIgnoredDuringExecution: {
              nodeSelectorTerms: [
                {
                  matchExpressions: [
                    {key: $nodeSelectorKey, operator: "In", values: [$nodeSelectorValue]}
                  ]
                }
              ]
            }
          }
        }
      else . end
  ' >"$vm_json"

	jq -e \
		--arg annotation "$VOLUME_TEMPLATE_ANNOTATION" \
		--arg dataPrefix "$DATA_VOLUME_PREFIX" \
		--argjson dataCount "$DATA_VOLUME_COUNT" \
		--argjson pvcCount "$((DATA_VOLUME_COUNT + 1))" '
      .apiVersion == "kubevirt.io/v1"
      and .kind == "VirtualMachine"
      and ((.metadata.annotations[$annotation] | fromjson) | length == $pvcCount)
      and ([.spec.template.spec.volumes[] | select(.persistentVolumeClaim? != null)] | length == $pvcCount)
      and ([.spec.template.spec.volumes[] | select(.cloudInitNoCloud? != null)] | length == 1)
      and ([
        .spec.template.spec.domain.devices.disks[]
        | select(.name | startswith($dataPrefix + "-"))
      ] | length == $dataCount)
      and ([
        .spec.template.spec.domain.devices.disks[]
        | select(.name | startswith($dataPrefix + "-"))
        | .serial
      ] | length == $dataCount and (unique | length == $dataCount))
    ' "$vm_json" >/dev/null || fail "generated VM manifest failed internal validation"

	kubectl apply -f "$vm_json" >/dev/null
}

run_iteration() {
	local worker="$1"
	local iteration="$2"
	local attempt="${3:-1}"
	local vm_retries="${4:-0}"
	local cdi_retries="${5:-0}"
	local max_attempts=$((SSH_VM_RETRIES + CDI_CLONE_RETRIES + 1))
	local attempt_suffix=""
	local object_attempt_suffix=""
	local iteration_id=""
	local retry_kind="vm"
	local retry_reason=""
	local VM_JSON=""
	local ROOT_PAYLOAD_NAME=""
	local ROOT_SOURCE_CHECKSUM=""
	local ROOT_RESTORED_CHECKSUM=""
	local RESTORE_JSON=""
	local data_index=0
	local volume_name=""
	local restored_pvc=""
	local checksum=""
	local restored_checksum=""
	local device=""
	local mount_path=""
	local read_exit_code=0
	local -a DATA_PVC_NAMES=()
	local -a DATA_PAYLOAD_NAMES=()
	local -a DATA_DEVICES=()
	local -a DATA_MOUNTS=()
	local -a DATA_SOURCE_CHECKSUMS=()
	local -a DATA_RESTORED_CHECKSUMS=()

	if ((attempt > 1)); then
		attempt_suffix="-a${attempt}"
		object_attempt_suffix="a${attempt}"
	fi
	iteration_id="worker-${worker}-iteration-${iteration}${attempt_suffix}"
	CURRENT_ITERATION="$iteration_id"
	CURRENT_VM="$(resource_name "${RUN_TOKEN}w${worker}v${iteration}${object_attempt_suffix}")"
	CURRENT_BACKUP="$(resource_name "${RUN_TOKEN}w${worker}b${iteration}${object_attempt_suffix}")"
	CURRENT_BACKUP_TYPE="$(vm_backup_type_for_iteration "$worker" "$iteration")"
	CURRENT_RESTORE="$(resource_name "${RUN_TOKEN}w${worker}r${iteration}${object_attempt_suffix}")"
	CURRENT_RESTORED_VM="$(resource_name "${RUN_TOKEN}w${worker}n${iteration}${object_attempt_suffix}")"
	VM_JSON="${STRESS_TMP_DIR}/worker-${worker}-vm-${iteration}${attempt_suffix}.json"
	CURRENT_BOOT_PVC="${CURRENT_VM}-pvc-${BOOT_TEMPLATE_INDEX}"
	ROOT_PAYLOAD_NAME=".csi-stress-${RUN_ID}-${iteration_id}-root.bin"
	for ((data_index = 1; data_index <= DATA_VOLUME_COUNT; data_index++)); do
		DATA_PVC_NAMES[$data_index]="$(data_pvc_name "$CURRENT_VM" "$data_index")"
		DATA_PAYLOAD_NAMES[$data_index]=".csi-stress-${RUN_ID}-${iteration_id}-data-${data_index}.bin"
		DATA_DEVICES[$data_index]="$(guest_data_device "$data_index")"
		DATA_MOUNTS[$data_index]="$(guest_data_mount "$data_index")"
	done
	validate_remote_engine_names "$CURRENT_BOOT_PVC" "${DATA_PVC_NAMES[@]}"
	CURRENT_FAILURE_CATEGORY="vm-creation-failure"
	SSH_FAILURE_STAGE=""
	LAST_SSH_ERROR=""
	CURRENT_DIAGNOSTICS_COLLECTED=false

	log "Starting iteration ${iteration}/${ITERATIONS} (attempt ${attempt}/${max_attempts})"
	log "Creating VM ${NAMESPACE}/${CURRENT_VM}"
	create_iteration_vm "$iteration_id" "$VM_JSON"
	CURRENT_FAILURE_CATEGORY="storage-provisioning-failure"
	if ! wait_for_resource pvc "$CURRENT_BOOT_PVC" '.status.phase == "Bound"' \
		"block boot PVC" \
		'((.metadata.annotations["cdi.kubevirt.io/storage.pod.restarts"] // "0") | tonumber? // 0) >= 3'; then
		retry_reason="Boot PVC provisioning failed for source VM ${CURRENT_VM}"
		if cdi_clone_auth_failed "$CURRENT_BOOT_PVC"; then
			CURRENT_FAILURE_CATEGORY="cdi-clone-auth-failure"
			retry_kind="cdi"
			retry_reason="CDI clone source pod returned HTTP 401"
		fi
		if retry_iteration "$worker" "$iteration" "$attempt" \
			"$vm_retries" "$cdi_retries" "$retry_kind" "$retry_reason"; then
			return 0
		fi
		return 1
	fi
	label_boot_storage_resources "$CURRENT_BOOT_PVC" "$iteration_id"
	for ((data_index = 1; data_index <= DATA_VOLUME_COUNT; data_index++)); do
		if ! wait_for_resource pvc "${DATA_PVC_NAMES[$data_index]}" \
			'.status.phase == "Bound"' "data PVC ${data_index}/${DATA_VOLUME_COUNT}"; then
			if retry_iteration "$worker" "$iteration" "$attempt" "$vm_retries" \
				"$cdi_retries" vm \
				"Data PVC ${data_index} provisioning failed for source VM ${CURRENT_VM}"; then
				return 0
			fi
			return 1
		fi
	done
	CURRENT_FAILURE_CATEGORY="vm-readiness-failure"
	if ! wait_for_resource virtualmachines.kubevirt.io "$CURRENT_VM" '.status.ready == true' "source VM"; then
		if retry_iteration "$worker" "$iteration" "$attempt" "$vm_retries" \
			"$cdi_retries" vm \
			"VM readiness failed for source VM ${CURRENT_VM}"; then
			return 0
		fi
		return 1
	fi
	CURRENT_FAILURE_CATEGORY="guest-readiness-failure"
	if ! wait_for_guest_ssh "$CURRENT_VM"; then
		if retry_iteration "$worker" "$iteration" "$attempt" "$vm_retries" \
			"$cdi_retries" vm \
			"Guest readiness failed for source VM ${CURRENT_VM}"; then
			return 0
		fi
		return 1
	fi

	CURRENT_FAILURE_CATEGORY="guest-io-failure"
	log "Writing ${ROOT_DATA_SIZE_GIB} GiB of data to the source root disk in VM ${CURRENT_VM}"
	ROOT_SOURCE_CHECKSUM="$(write_root_payload "$CURRENT_VM" "$ROOT_PAYLOAD_NAME")"
	[[ "$ROOT_SOURCE_CHECKSUM" =~ ^[a-f0-9]{64}$ ]] ||
		fail "invalid source root-disk checksum: ${ROOT_SOURCE_CHECKSUM@Q}"
	log "Source root-disk checksum: ${ROOT_SOURCE_CHECKSUM}"

	for ((data_index = 1; data_index <= DATA_VOLUME_COUNT; data_index++)); do
		device="${DATA_DEVICES[$data_index]}"
		mount_path="${DATA_MOUNTS[$data_index]}"
		log "Writing ${DATA_SIZE_GIB} GiB to source data disk" \
			"${data_index}/${DATA_VOLUME_COUNT} (${device}) in VM ${CURRENT_VM}"
		checksum="$(write_guest_payload \
			"$CURRENT_VM" \
			"${DATA_PAYLOAD_NAMES[$data_index]}" \
			"$device" \
			"$mount_path")"
		[[ "$checksum" =~ ^[a-f0-9]{64}$ ]] ||
			fail "invalid source data-disk ${data_index} checksum: ${checksum@Q}"
		DATA_SOURCE_CHECKSUMS[$data_index]="$checksum"
		log "Source data-disk ${data_index} checksum: ${checksum}"
	done

	CURRENT_FAILURE_CATEGORY="backup-failure"
	log "Creating VM backup ${NAMESPACE}/${CURRENT_BACKUP} with type ${CURRENT_BACKUP_TYPE}"
	jq -n \
		--arg namespace "$NAMESPACE" \
		--arg name "$CURRENT_BACKUP" \
		--arg vm "$CURRENT_VM" \
		--arg run "$RUN_ID" \
		--arg iteration "$iteration_id" \
		--arg backupType "$CURRENT_BACKUP_TYPE" \
		--arg runLabel "$STRESS_RUN_LABEL" \
		--arg iterationLabel "$STRESS_ITERATION_LABEL" '
      {
        apiVersion: "harvesterhci.io/v1beta1",
        kind: "VirtualMachineBackup",
        metadata: {
          name: $name,
          namespace: $namespace,
          annotations: {"harvesterhci.io/snapshotFreezeFS": "true"},
          labels: {($runLabel): $run, ($iterationLabel): $iteration}
        },
        spec: {
          source: {apiGroup: "kubevirt.io", kind: "VirtualMachine", name: $vm},
          type: $backupType
        }
      }
    ' | kubectl apply -f - >/dev/null
	wait_for_resource virtualmachinebackups.harvesterhci.io "$CURRENT_BACKUP" \
		'.status.readyToUse == true' "VM backup (${CURRENT_BACKUP_TYPE})" '.status.error.message? != null' \
		"$SNAPSHOT_ERROR_GRACE_SECONDS"
	verify_status_volumes virtualmachinebackups.harvesterhci.io \
		"$CURRENT_BACKUP" volumeBackups "VM snapshot ${CURRENT_BACKUP}"

	CURRENT_FAILURE_CATEGORY="source-vm-stop-failure"
	log "Stopping source VM ${CURRENT_VM} before starting its restored copy"
	kubectl patch virtualmachines.kubevirt.io "$CURRENT_VM" -n "$NAMESPACE" \
		--type merge -p '{"spec":{"runStrategy":"Halted"}}' >/dev/null
	wait_for_launcher_absent "$CURRENT_VM"

	CURRENT_FAILURE_CATEGORY="restore-failure"
	log "Restoring ${CURRENT_BACKUP_TYPE} backup ${CURRENT_BACKUP} to VM ${CURRENT_RESTORED_VM}"
	jq -n \
		--arg namespace "$NAMESPACE" \
		--arg name "$CURRENT_RESTORE" \
		--arg backup "$CURRENT_BACKUP" \
		--arg restoredVM "$CURRENT_RESTORED_VM" \
		--arg run "$RUN_ID" \
		--arg iteration "$iteration_id" \
		--arg runLabel "$STRESS_RUN_LABEL" \
		--arg iterationLabel "$STRESS_ITERATION_LABEL" '
      {
        apiVersion: "harvesterhci.io/v1beta1",
        kind: "VirtualMachineRestore",
        metadata: {
          name: $name,
          namespace: $namespace,
          labels: {($runLabel): $run, ($iterationLabel): $iteration}
        },
        spec: {
          newVM: true,
          target: {apiGroup: "kubevirt.io", kind: "VirtualMachine", name: $restoredVM},
          virtualMachineBackupName: $backup,
          virtualMachineBackupNamespace: $namespace
        }
      }
    ' | kubectl apply -f - >/dev/null
	wait_for_resource virtualmachinerestores.harvesterhci.io "$CURRENT_RESTORE" \
		'.status.complete == true' "VM restore" '.status.error.message? != null'
	verify_status_volumes virtualmachinerestores.harvesterhci.io \
		"$CURRENT_RESTORE" restores "VM restore ${CURRENT_RESTORE}"
	CURRENT_FAILURE_CATEGORY="restored-vm-readiness-failure"
	if ! wait_for_resource virtualmachines.kubevirt.io "$CURRENT_RESTORED_VM" '.status.ready == true' "restored VM"; then
		if retry_iteration "$worker" "$iteration" "$attempt" "$vm_retries" \
			"$cdi_retries" vm \
			"VM readiness failed for restored VM ${CURRENT_RESTORED_VM}"; then
			return 0
		fi
		return 1
	fi
	label_restored_resources "$CURRENT_RESTORED_VM" "$iteration_id"

	RESTORE_JSON="$(kubectl get virtualmachinerestores.harvesterhci.io \
		"$CURRENT_RESTORE" -n "$NAMESPACE" -o json)"
	CURRENT_FAILURE_CATEGORY="restored-storage-provisioning-failure"
	for ((data_index = 1; data_index <= DATA_VOLUME_COUNT; data_index++)); do
		volume_name="$(data_volume_name "$data_index")"
		restored_pvc="$(jq -r --arg volume "$volume_name" '
          [.status.restores[]? | select(.volumeName == $volume)]
          | if length == 1 then
              .[0].persistentVolumeClaimSpec.metadata.name // empty
            else
              empty
            end
        ' <<<"$RESTORE_JSON")"
		[[ -n "$restored_pvc" ]] ||
			fail "restore status does not contain exactly one PVC for VM volume ${volume_name}"
		if ! wait_for_resource pvc "$restored_pvc" '.status.phase == "Bound"' \
			"restored data PVC ${data_index}/${DATA_VOLUME_COUNT}"; then
			if retry_iteration "$worker" "$iteration" "$attempt" "$vm_retries" \
				"$cdi_retries" vm \
				"Data PVC ${data_index} provisioning failed for restored VM ${CURRENT_RESTORED_VM}"; then
				return 0
			fi
			return 1
		fi
	done
	CURRENT_FAILURE_CATEGORY="restored-guest-readiness-failure"
	if ! wait_for_guest_ssh "$CURRENT_RESTORED_VM"; then
		if retry_iteration "$worker" "$iteration" "$attempt" "$vm_retries" \
			"$cdi_retries" vm \
			"Guest readiness failed for restored VM ${CURRENT_RESTORED_VM}"; then
			return 0
		fi
		return 1
	fi

	CURRENT_FAILURE_CATEGORY="integrity-read-failure"
	log "Checking data checksum on the restored root disk in VM ${CURRENT_RESTORED_VM}"
	if ROOT_RESTORED_CHECKSUM="$(read_root_payload "$CURRENT_RESTORED_VM" "$ROOT_PAYLOAD_NAME")"; then
		:
	else
		read_exit_code=$?
		if ((read_exit_code == 75)); then
			CURRENT_FAILURE_CATEGORY="integrity-transport-failure"
		fi
		return "$read_exit_code"
	fi
	if [[ ! "$ROOT_RESTORED_CHECKSUM" =~ ^[a-f0-9]{64}$ ]]; then
		CURRENT_FAILURE_CATEGORY="integrity-output-failure"
		fail "invalid restored root-disk checksum: ${ROOT_RESTORED_CHECKSUM@Q}"
	fi
	log "Restored root-disk checksum: ${ROOT_RESTORED_CHECKSUM}"

	for ((data_index = 1; data_index <= DATA_VOLUME_COUNT; data_index++)); do
		device="${DATA_DEVICES[$data_index]}"
		mount_path="${DATA_MOUNTS[$data_index]}"
		log "Checking checksum on restored data disk" \
			"${data_index}/${DATA_VOLUME_COUNT} (${device}) in VM ${CURRENT_RESTORED_VM}"
		if checksum="$(read_guest_payload \
			"$CURRENT_RESTORED_VM" \
			"${DATA_PAYLOAD_NAMES[$data_index]}" \
			"$device" \
			"$mount_path")"; then
			:
		else
			read_exit_code=$?
			if ((read_exit_code == 75)); then
				CURRENT_FAILURE_CATEGORY="integrity-transport-failure"
			fi
			return "$read_exit_code"
		fi
		if [[ ! "$checksum" =~ ^[a-f0-9]{64}$ ]]; then
			CURRENT_FAILURE_CATEGORY="integrity-output-failure"
			fail "invalid restored data-disk ${data_index} checksum: ${checksum@Q}"
		fi
		DATA_RESTORED_CHECKSUMS[$data_index]="$checksum"
		log "Restored data-disk ${data_index} checksum: ${checksum}"
	done

	if [[ "$ROOT_SOURCE_CHECKSUM" != "$ROOT_RESTORED_CHECKSUM" ]]; then
		CURRENT_FAILURE_CATEGORY="integrity-mismatch"
		fail "root-disk integrity failure in ${iteration_id}: source=${ROOT_SOURCE_CHECKSUM}, restored=${ROOT_RESTORED_CHECKSUM}"
	fi
	for ((data_index = 1; data_index <= DATA_VOLUME_COUNT; data_index++)); do
		checksum="${DATA_SOURCE_CHECKSUMS[$data_index]}"
		restored_checksum="${DATA_RESTORED_CHECKSUMS[$data_index]}"
		if [[ "$checksum" == "$restored_checksum" ]]; then
			continue
		fi
		CURRENT_FAILURE_CATEGORY="integrity-mismatch"
		fail "data-disk ${data_index} integrity failure in ${iteration_id}:" \
			"source=${checksum}, restored=${restored_checksum}"
	done
	log "Iteration ${iteration} passed root-disk and ${DATA_VOLUME_COUNT}" \
		"data-disk integrity verification"
}

worker_on_exit() {
	local exit_code=$?
	local preserve_failed_iteration=false
	trap - EXIT INT TERM

	if ((exit_code != 0)) && [[ "$WORKER_SIGNALLED" == false ]] && [[ -n "$CURRENT_ITERATION" ]]; then
		if [[ "$CURRENT_DIAGNOSTICS_COLLECTED" == false ]]; then
			dump_iteration_diagnostics || true
		fi
		if [[ "$KEEP_FAILED_RESOURCES" == true ]]; then
			preserve_failed_iteration=true
		fi
	fi

	if [[ "$KEEP_RESOURCES" == true ]]; then
		:
	elif [[ "$preserve_failed_iteration" == true ]]; then
		log "Keeping failed resources from ${CURRENT_ITERATION} for investigation"
		log "Resource selector: ${STRESS_RUN_LABEL}=${RUN_ID},${STRESS_ITERATION_LABEL}=${CURRENT_ITERATION}"
	else
		cleanup_iteration || true
	fi
	exit "$exit_code"
}

run_iteration_worker() {
	local worker="$1"
	local iteration=0

	WORKER_SIGNALLED=false
	trap worker_on_exit EXIT
	trap 'WORKER_SIGNALLED=true; exit 130' INT
	trap 'WORKER_SIGNALLED=true; exit 143' TERM

	for ((iteration = 1; iteration <= ITERATIONS; iteration++)); do
		LOG_PREFIX="[worker ${worker}, iteration ${iteration}] "
		run_iteration "$worker" "$iteration"
		if [[ "$KEEP_RESOURCES" == false ]]; then
			CURRENT_FAILURE_CATEGORY="cleanup-failure"
			cleanup_iteration
		else
			clear_iteration_state
		fi
	done

	LOG_PREFIX="[worker ${worker}] "
	log "Completed all ${ITERATIONS} iteration(s)"
}

remove_active_pid() {
	local completed_pid="$1"
	local pid=""
	local remaining_pids=()

	for pid in "${ACTIVE_PIDS[@]}"; do
		if [[ "$pid" != "$completed_pid" ]]; then
			remaining_pids+=("$pid")
		fi
	done
	ACTIVE_PIDS=("${remaining_pids[@]}")
}

wait_for_one_worker() {
	local completed_pid=""
	local exit_code=0

	if wait -n -p completed_pid "${ACTIVE_PIDS[@]}"; then
		exit_code=0
	else
		exit_code=$?
	fi
	if [[ -n "${completed_pid:-}" ]]; then
		remove_active_pid "$completed_pid"
	fi
	return "$exit_code"
}

run_iterations() {
	local worker=0
	local exit_code=0

	for ((worker = 1; worker <= PARALLEL; worker++)); do
		(run_iteration_worker "$worker") &
		ACTIVE_PIDS+=("$!")
	done

	while ((${#ACTIVE_PIDS[@]} > 0)); do
		if wait_for_one_worker; then
			continue
		else
			exit_code=$?
			log "An iteration worker failed with exit code ${exit_code}" >&2
			terminate_workers
			return "$exit_code"
		fi
	done
}

log "Starting ${PARALLEL} concurrent worker(s), ${ITERATIONS} iteration(s) each ($((PARALLEL * ITERATIONS)) total)"
run_iterations

if [[ "$KEEP_RESOURCES" == false ]]; then
	cleanup_image
fi

log "All ${PARALLEL} worker(s) completed ${ITERATIONS} iteration(s) successfully ($((PARALLEL * ITERATIONS)) total)"
